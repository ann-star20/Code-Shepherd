# ===== LangSmith (Harness) — CLAUDE.md 섹션 3 필수 =====
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__xxxx
LANGCHAIN_PROJECT=dev2-alice          # 반드시 dev2-{본인 GitHub ID} 형식 사용
                                       # 예: dev2-alice, dev2-bob
                                       # ⚠️ dev2-agent 같은 역할명만 쓰면 팀원 trace가 섞임

# ===== LLM — 팀 표준 Claude =====
ANTHROPIC_API_KEY=sk-ant-xxxx
USE_MOCK_LLM=true                     # 개발 중 true, 통합 테스트/데모 시 false

# ===== Cloud SQL (PostgreSQL) — OLTP + pgVector =====
# 로컬 개발: Cloud SQL Auth Proxy를 먼저 실행한 뒤 localhost로 접속
#   cloud_sql_proxy -instances=PROJECT:REGION:INSTANCE=tcp:5432
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dev2_db
#
# Cloud Run 배포 시: unix socket 경로 사용
#   DATABASE_URL=postgresql+asyncpg://user:password@/dev2_db?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dev2_db
# 팀 chunk_embeddings 실제 적재값 = bge-m3 / vector(1024). 질의 임베딩도 동일해야
# 유사도가 의미를 가진다(벡터 공간 일치). 세 곳(이 값/테이블 DDL/임베딩 모델) 통일 필수.
PGVECTOR_DIMENSION=1024               # bge-m3 = 1024 (Upstage:4096 / Ollama:768 — 미사용)
EMBEDDING_MODEL=BAAI/bge-m3           # USE_MOCK_LLM=false 시 로컬 sentence-transformers로 로드

# ===== Google Cloud 공통 인증 =====
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/service_account.json
# 또는 Cloud Run / GCE에서는 자동 인증(ADC)이 적용되므로 위 설정 불필요

# ===== BigQuery (OLAP — 분석 DW) =====
BIGQUERY_PROJECT_ID=your_gcp_project_id
BIGQUERY_DATASET=dev2_analytics
BIGQUERY_TABLE=scan_results
POSTGRES_URL=postgresql://postgres:tasklink1!@34.22.101.111:5432/tasklink
# ===== Slack (에스컬레이션 알림) =====
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
SLACK_CHANNEL_SECURITY=#team-security

# ===== Agent Service URLs (Mock 기반 개발용) =====
DEV4_WEBHOOK_URL=http://mock-server:8001/eval   # Critical 에스컬레이션 전달
