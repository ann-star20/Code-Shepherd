          {
            "lang": "python",
            "lang_version": ">=3.10",
            "framework": "django",
            "framework_version": ">=4.0",
            "code": "# settings.py\nMIDDLEWARE = [\n    'django.middleware.csrf.CsrfViewMiddleware',\n    ...\n]\n\n# 템플릿\n# <form method='post'>{% csrf_token %}</form>",
            "description": "Django CsrfViewMiddleware + {% csrf_token %} 태그로 토큰 검증"
