# ============================================================
#  test-performance-agent (Dev3) 환경변수 템플릿
#  사용법: 이 파일을 복사해서 .env 로 만들고, 아래 값을 채우세요.
#         (.env 는 절대 git 에 올리지 마세요 — .gitignore 에 포함)
# ============================================================

# --- DB (필수: GCP 적재용) ---
POSTGRES_URL=postgresql://postgres:tasklink1!@34.22.101.111:5432/tasklink

# --- LLM (Gemini 2.5 Flash) ---
# 엣지케이스/메모리누수 탐지기의 LLM 모드 활성화. 없으면 휴리스틱으로 동작.
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash

# --- 관찰(LangSmith) — 선택 ---
# 키 넣으면 탐지기 실행이 자동 추적됨. 없으면 추적만 생략(코드 동작엔 영향 없음).
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=dev3-test-performance

# ============================================================
#  채워야 할 것: GOOGLE_API_KEY, LANGCHAIN_API_KEY
#  → 키만 넣고 저장하면 코드 수정 없이 자동으로 켜집니다.
# ============================================================
