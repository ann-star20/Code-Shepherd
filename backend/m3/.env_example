ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GITHUB_TOKEN=github_pat_...
GITHUB_WEBHOOK_SECRET=   ← 8번에서 생성 후 기입
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
# ── 임베딩 provider (통합 불변조건: 기본 bge-m3, openai 폴백) ──
EMBEDDING_PROVIDER=ollama
# 직접실행=localhost, 도커=host.docker.internal
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
# ── DB (G3) — 기본 false: eval·개발 중 INSERT 금지 ──
ENABLE_DB_WRITE=false
POSTGRES_URL=postgresql://user:password@host:5432/db
