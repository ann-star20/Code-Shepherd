# ============================================================
#  m3 — 테스트 검증·성능 분석 환경변수 템플릿
#  사용법: 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
#         (.env 는 절대 git 에 올리지 마세요)
# ============================================================

# --- DB (GCP Cloud SQL / PostgreSQL) ---
POSTGRES_URL=postgresql://postgres:password@host:5432/dbname

# --- LLM (Gemini 2.5 Flash) ---
# 엣지케이스/메모리누수 탐지기 LLM 모드 활성화. 없으면 휴리스틱 동작.
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash

# --- RAG (기본 비활성) ---
# 활성화하면 BGE-M3 임베딩 + GCP 접속이 일어남
RAG_ENABLED=

# --- 관찰 (LangSmith) — 선택 ---
# 키 넣으면 탐지기 실행이 자동 추적됨. 없으면 추적만 생략.
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=m3-test-performance
