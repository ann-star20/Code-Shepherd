--- a/scripts/backfill_orders.py
+++ b/scripts/backfill_orders.py
@@ -1,4 +1,20 @@
 """주문 백필 스크립트 (일회성 배치)."""
 from __future__ import annotations

 import sys
+
+import requests
+
+LEGACY_API = "https://legacy.internal/orders"
+
+
+def fetch_legacy_orders(since: str) -> list[dict]:
+    resp = requests.get(LEGACY_API, params={"since": since}, timeout=30)
+    resp.raise_for_status()
+    return resp.json()
+
+
+if __name__ == "__main__":
+    since = sys.argv[1] if len(sys.argv) > 1 else "2024-01-01"
+    orders = fetch_legacy_orders(since)
+    print(f"fetched {len(orders)} orders")
