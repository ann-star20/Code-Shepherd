# ============================================================
#  pr-comment-agent 환경변수 템플릿
#  사용법: 이 파일을 복사해서 .env 로 만들고, 아래 값을 채우세요.
#         (.env 는 절대 git 에 올리지 마세요)
# ============================================================

# --- LLM (Gemini 2.5 Flash) ---
# 코멘트를 신입 수준에 맞춰 다듬는 데 사용. 없으면 휴리스틱 템플릿으로 동작.
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash

# --- GitHub (PR 코멘트 실제 등록) ---
# 없으면 dry-run(파일 .dry_run_comments/ 에 저장)으로 동작.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# --- 관찰(LangSmith) — 선택 ---
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=dev3-pr-comment

# ============================================================
#  채워야 할 것: GOOGLE_API_KEY, GITHUB_TOKEN, LANGCHAIN_API_KEY
#  → 키만 넣으면 dry-run/휴리스틱이 실제 동작으로 자동 전환됩니다.
# ============================================================
