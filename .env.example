# ============================================================
# 조직 지식 관리 + 개발자 온보딩 플랫폼 — 환경변수 설정
# 이 파일을 복사해서 .env로 사용: cp .env.example .env
# .env는 절대 git에 커밋하지 않는다
# ============================================================

# ===== LangSmith (Harness) =====
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__xxxx
# ⚠️ 반드시 본인 GitHub ID를 포함시킬 것 (예: dev1-alice, dev2-bob)
# 같은 이름 사용 시 팀원 trace가 하나의 LangSmith 프로젝트에 섞임
# 개발 중: dev{N}-{yourGitHubId} / 통합 주간(Week 5): onboarding-platform-integrated
LANGCHAIN_PROJECT=dev1-yourGitHubId

# ===== LLM — Gemini 2.5 Flash (팀 전체 통일) =====
# 멀티모달 지원 (이미지·표 포함 문서 처리 + 피드백 생성 모두 이걸로 사용)
GOOGLE_API_KEY=AIzaxxxx
GEMINI_MODEL=gemini-2.5-flash

# 개발 중 true → 실제 LLM 호출 없음 / 통합 테스트·데모 시 false
USE_MOCK_LLM=true

# ===== Database (PostgreSQL + pgVector) =====
POSTGRES_URL=postgresql://user:password@localhost:5432/onboarding_db

# 임베딩 모델: Ollama bge-m3 (1024차원, 한국어 포함 다국어)
# 아래 세 곳이 반드시 동일해야 한다 — 하나라도 다르면 첫 번째 INSERT에서 오류 발생
#   1) 여기 PGVECTOR_DIMENSION
#   2) schema.sql  → vector(1024)
#   3) seed INSERT → ::vector(1024)
PGVECTOR_DIMENSION=1024

# ===== Graph DB (Neo4j) =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ===== Storage — GCS (Google Cloud Storage) =====
STORAGE_BACKEND=gcs
GCS_BUCKET=your-gcs-bucket-name
# 인증: Application Default Credentials
#   로컬: gcloud auth application-default login
#   Cloud Run: 자동 (Compute Engine 기본 서비스 계정)

# ===== GitHub =====
GITHUB_WEBHOOK_SECRET=your-hmac-secret
GITHUB_TOKEN=ghp_xxxx

# ===== Slack =====
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_CHANNEL_SECURITY=#team-security
SLACK_CHANNEL_REVIEW=#team-backend

# ===== Agent Service URLs (Mock 기반 개발 — Week 2~3) =====
# Week 5 통합 시 실제 서비스 주소로 교체
ANALYSIS_AGENT_URL=http://mock-server:8001/analysis
KMS_AGENT_URL=http://mock-server:8001/kms
EVAL_AGENT_URL=http://mock-server:8001/eval
CURRICULUM_AGENT_URL=http://mock-server:8001/curriculum

# ============================================================
# 문서 변환 + 임베딩 모델 선택
# 아래 두 옵션 중 하나만 활성화 (나머지는 주석 처리)
# ============================================================

# ------------------------------------------------------------
# [옵션 A] 유료 API — Upstage + UnStructured.io
# ------------------------------------------------------------
# EMBEDDING_PROVIDER=upstage
# UPSTAGE_API_KEY=up_xxxx
# UPSTAGE_EMBEDDING_MODEL=solar-embedding-1-large
# 차원: 4096 → pgVector max(2000) 초과로 사용 불가
# UNSTRUCTURED_API_KEY=xxxx
# UNSTRUCTURED_API_URL=https://api.unstructured.io/general/v0/general

# ------------------------------------------------------------
# [옵션 B] 무료 로컬 — Ollama bge-m3 (팀 확정 모델)
# 사용 전 설치: https://ollama.com/download
# 모델 다운로드:
#   ollama pull bge-m3                # 임베딩 (1024차원, 한국어 포함 다국어)
#   ollama pull gemma3                # 문서 변환 보조 (멀티모달 지원)
# ------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
# 차원: 1024 → PGVECTOR_DIMENSION=1024 (위에서 설정됨)
OLLAMA_VISION_MODEL=gemma3            # 문서 파싱 보조용

# ===== CORS 설정 =====
# 로컬 개발: * 허용 (기본값)
# Cloud Run 배포 시: 프론트엔드 URL로 반드시 교체 — 열린 CORS는 Webhook 노출 위험
# 예시: CORS_ORIGINS=https://your-frontend.run.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== 에이전트 실행 설정 =====
AGENT_TIMEOUT_SECONDS=30

# ===== KMS 파이프라인 설정 =====
ANTHROPIC_API_KEY=sk-ant-xxxx            # Stage 2(Markdown 검증), Stage 5(메타데이터 추출)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Storage: 위 GCS 섹션 참고 (STORAGE_BACKEND, GCS_BUCKET)
# LOCAL_STORAGE_PATH=./data/storage  ← STORAGE_BACKEND=local 사용 시 활성화

# Markdown 품질 임계값 (이 값 미만이면 HITL 등록)
MARKDOWN_QUALITY_THRESHOLD=0.8

# PDF 이미지 비율 임계값 (이 값 이상이면 Gemini Multimodal 폴백 사용)
GEMINI_FALLBACK_IMAGE_RATIO=0.3