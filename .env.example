# DB (팀 Cloud SQL — 공인 IP 직접 접속)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Proxy 없이 쓸 때는 비워 두거나 더미 (compose에서 proxy 안 띄우면 무시됨)
CLOUDSQL_INSTANCE_CONNECTION_NAME=

# Auth
JWT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Orchestrator
GITHUB_WEBHOOK_SECRET=

# m1 → api-core PR ingest (internal)
API_CORE_URL=http://api-core:8000
INTERNAL_SERVICE_TOKEN=

# Service URLs (compose internal hosts)
M0_URL=http://m0:8002
M2_URL=http://m2:8003
M3_URL=http://m3:8004
M4_URL=http://m4:8005
M5_URL=http://m5:8006

# Module 5 — GraphDB (compose neo4j 또는 Neo4j Aura)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
