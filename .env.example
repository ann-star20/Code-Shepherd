# ============================================================
# 조직 지식 관리 + 개발자 온보딩 플랫폼 — 환경변수 설정
# 이 파일을 복사해서 .env로 사용: cp .env.example .env
# .env는 절대 git에 커밋하지 않는다
# ============================================================

# ===== LangSmith (Harness) =====
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
# ⚠️ 반드시 본인 GitHub ID를 포함시킬 것 (예: dev1-alice, dev2-bob)
# 같은 이름 사용 시 팀원 trace가 하나의 LangSmith 프로젝트에 섞임
# 개발 중: dev{N}-{yourGitHubId} / 통합 주간(Week 5): onboarding-platform-integrated
LANGCHAIN_PROJECT=dev1-yourGitHubId

# ===== LLM — Gemini 2.5 Flash (팀 전체 통일) =====
# 멀티모달 지원 (이미지·표 포함 문서 처리 + 피드백 생성 모두 이걸로 사용)
# ⚠️ 코드가 읽는 변수명은 LLM_MODEL 이다 (GEMINI_MODEL 아님).
# 참고: gemini-2.5-flash 무료 등급은 하루 20회(프로젝트 단위). 데모 중 소진되면
#       LLM 코멘트가 규칙기반으로 강등됨 → 새 GCP 프로젝트 키 또는 billing 등록으로 해결.
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash

# ===== 임베딩 — 하이브리드 =====
# child chunk 수 > LARGE_DOC_CHUNK_THRESHOLD 이면 OpenAI text-embedding-3-small 자동 사용
LARGE_DOC_CHUNK_THRESHOLD=50
OPENAI_API_KEY=

# 개발 중 true → 실제 LLM 호출 없음 / 통합 테스트·데모 시 false
USE_MOCK_LLM=true

# ===== RAG (사내 컨벤션 검색) =====
# m3 기본 ON: 탐지 이슈마다 GCP chunks 검색 → rag_context 채움.
# 단위테스트는 conftest _rag_off autouse 가 자동으로 unset → BGE-M3·GCP 비접촉.
RAG_ENABLED=1

# ===== Database (PostgreSQL + pgVector) =====
POSTGRES_URL=postgresql://user:password@host:5432/dbname

# Cloud SQL (팀 Cloud SQL — 공인 IP 직접 접속)
DB_HOST=34.22.101.111
DB_PORT=5432
DB_NAME=tasklink
DB_USER=postgres
DB_PASSWORD=tasklink1!
CLOUDSQL_INSTANCE_CONNECTION_NAME=tasklink-379606:asia-northeast3:tasklink-db

# 임베딩 모델: Ollama bge-m3 (1024차원, 한국어 포함 다국어)
# 아래 세 곳이 반드시 동일해야 한다 — 하나라도 다르면 첫 번째 INSERT에서 오류 발생
#   1) 여기 PGVECTOR_DIMENSION
#   2) schema.sql  → vector(1024)
#   3) seed INSERT → ::vector(1024)
PGVECTOR_DIMENSION=1024

# Storage 백엔드 — gcs: Google Cloud Storage (팀 공유)
STORAGE_BACKEND=
GCS_BUCKET=
GCS_PROJECT=

# ===== Graph DB (Neo4j) =====
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=


# ===== Auth =====
JWT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ===== Orchestrator =====
GITHUB_WEBHOOK_SECRET=

# ===== GitHub =====
GITHUB_TOKEN=

# ===== Slack =====
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_SECURITY=#team-security
SLACK_CHANNEL_REVIEW=#team-backend

# ===== Internal service / module URLs =====
# m1 → api-core PR ingest (internal)
API_CORE_URL=http://api-core:8000
INTERNAL_SERVICE_TOKEN=

# Service URLs (compose internal hosts)
M0_URL=http://m0:8002
M2_URL=http://m2:8003
M3_URL=http://m3:8004
M4_URL=http://m4:8005
M5_URL=http://m5:8006


# [옵션 B] 무료 로컬 — Ollama bge-m3 (팀 확정 모델)
# 사용 전 설치: https://ollama.com/download
# 모델 다운로드:
#   ollama pull bge-m3                # 임베딩 (1024차원, 한국어 포함 다국어)
#   ollama pull gemma3                # 문서 변환 보조 (멀티모달 지원)
# ------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
# ⚠️ Docker Compose로 실행 시: 컨테이너에서 호스트 Ollama 접근은 host.docker.internal 사용
#    (컨테이너 내부의 localhost는 컨테이너 자신을 가리켜 연결 거부됨)
# 호스트에서 직접 실행(uv run) 시에는 http://localhost:11434 로 변경
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
# 차원: 1024 → PGVECTOR_DIMENSION=1024 (위에서 설정됨)
OLLAMA_VISION_MODEL=gemma3            # 문서 파싱 보조용

